#
# V8Sharp: the asm.js tests of V8 14.7.173.23 (test/mjsunit/asm,
# test/mjsunit/regress/asm, test/mjsunit/wasm/asm-*.js,
# test/mjsunit/asm-directive.js), which this tree's revision of V8 removed
# with src/asmjs. These are the entries of 14.7's mjsunit.status that concern
# them; mjsunit.js and wasm/wasm-module-builder.js are 14.7's too.

[
[ALWAYS, {
  # Helpers, not tests.
  'mjsunit': [SKIP],
  'wasm/wasm-module-builder': [SKIP],

  # OOM flakes in isolates tests because too many largish heaps are created.
  'asm/asm-heap': [PASS, NO_VARIANTS, ['isolates', SKIP]],

  # Slow tests.
  'asm/embenchen/*': [PASS, SLOW, NO_VARIANTS],
  'asm/poppler/*': [PASS, SLOW, NO_VARIANTS],
  'regress/asm/regress-775710': [PASS, SLOW],
}],  # ALWAYS

##############################################################################
# TODO(v8:7777): Change this once wasm is supported in jitless mode.
['not has_webassembly or (variant == jitless and not has_wasm_interpreter)', {
  # Skip tests that require webassembly.
  'regress/asm/*': [SKIP],
  'asm/*': [SKIP],
  'wasm/*': [SKIP],
}],  # not has_webassembly or variant == jitless
]
