<Project Sdk="Microsoft.NET.Sdk">

  <!-- Benchmarks the port against the real V8 (oracle) on the same workloads:
       Octane and test/js-perf-test. Each measurement runs in its own process
       because V8 flags (jit modes) are process-global. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>V8Sharp.Bench</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- ReadyToRun when published for a runtime (as d8sharp), so the in-process
       v8sharp engines can be measured precompiled: publish to a directory and
       name it with <engine>@<dir> (README). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/V8Sharp/V8Sharp.csproj" />
    <ProjectReference Include="../../src/V8Sharp.Oracle/V8Sharp.Oracle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" />
  </ItemGroup>

</Project>
